// This is the file you edit. It declares what your provider offers and implements the calls Treno
// makes. The gRPC plumbing, the handshake and the health check live in the Treno SDK.
//
// Declare the provider and each kind of service once, with its handlers attached: Treno's forms
// follow from what you write here, and every call is routed to the right handler by kind. If your
// provider needs more than one tool, take the secrets for each as inputs.
//
// Each handler is annotated with the request and response types the SDK exports, named for the
// entity and the call (ServiceProvisionRequest, ServiceProvisionResponse). Your editor completes
// the request's fields, and the compiler checks what you return.

import {
  createProvider,
  type ProviderValidateRequest,
  type ProviderValidateResponse,
  type ServiceDeprovisionRequest,
  type ServiceDeprovisionResponse,
  type ServiceGetAccessRequest,
  type ServiceGetAccessResponse,
  type ServiceGrantAccessRequest,
  type ServiceGrantAccessResponse,
  type ServiceProvisionRequest,
  type ServiceProvisionResponse,
  type ServiceRevokeAccessRequest,
  type ServiceRevokeAccessResponse,
} from '@treno-dev/treno-sdk/provider';

// Treno builds the provider's form from `inputs` and `secrets`, so they are also the documentation
// people see. Settings arrive in `credential.inputs`, and secrets, kept and sent separately, in
// `credential.secrets`.
const provider = createProvider({
  name: '[[.Name]]',
  version: '0.1.0',
  title: '[[.Title]]',
  description: 'Connects Treno to [[.Title]].',

  // The settings this provider is configured with.
  inputs: [
    { name: 'base_url', label: 'Base URL', description: 'The base URL of the API.', type: 'string', required: true },
  ],

  // The secrets it is configured with.
  secrets: [{ name: 'API_TOKEN', description: 'The token to call the API with.', required: true }],

  // Check that the inputs and secrets work. Return an error for each input or secret the user can fix, in the list of what it is
  // about: `inputErrors`, `secretErrors`, or `errors` for what is about the credential as a whole.
  async validate(request: ProviderValidateRequest): Promise<ProviderValidateResponse> {
    const { credential } = request;
    const secretErrors: { field: string; message: string }[] = [];

    if (!credential.secrets.API_TOKEN) {
      secretErrors.push({ field: 'API_TOKEN', message: 'An API token is required.' });
    }

    return { errors: [], inputErrors: [], secretErrors };
  },
});

// A kind of service this provider manages. Handlers receive the request as a plain object and return
// the response as one, leaving out any field they have nothing to say about.
provider.service({
  kind: 'item',
  title: 'Item',
  description: 'An example service.',
  // What a service of this kind takes besides its name, which Treno stores with the kind.
  inputs: [{ name: 'description', label: 'Description', description: 'What the item is for.', type: 'string' }],
  outputs: [{ name: 'url', label: 'URL', description: 'Where the item can be opened.', type: 'string' }],

  // Create a service called `name`. Idempotent: if it already exists, succeed anyway. Return what
  // it produced, as declared in `outputs`.
  async provision(request: ServiceProvisionRequest): Promise<ServiceProvisionResponse> {
    const { credential, name, inputs } = request;
    const url = `${credential.inputs.base_url}/items/${name}`;

    return { outputs: { url } };
  },

  // Remove a service. Idempotent: succeed if it is already gone.
  async deprovision(request: ServiceDeprovisionRequest): Promise<ServiceDeprovisionResponse> {
    const { credential, service } = request;

    return {};
  },

  // What can be granted on this kind. Declaring permissions or roles is what makes the kind accept
  // access, along with the three access handlers below. The permissions are the pieces Treno builds
  // its own roles from; the roles are the ones the tool defines itself.
  permissions: [
    { name: 'view', title: 'View' },
    { name: 'edit', title: 'Edit' },
  ],
  roles: [
    { name: 'viewer', title: 'Viewer' },
    { name: 'editor', title: 'Editor' },
  ],

  // Give an identity a role on the service. Idempotent. `role` is always set. For a role Treno
  // composed, `permissions` lists its pieces. Return what the tool applied, an `id` for the grant if
  // the tool has one, and `pending: true` if the person has to act first, such as accepting an
  // invitation. `identity` has `externalId`, `name` and `attrs` (an email, say).
  async grantAccess(request: ServiceGrantAccessRequest): Promise<ServiceGrantAccessResponse> {
    const { credential, service, identity, role, permissions } = request;

    return { role, permissions };
  },

  // Take a role away. Idempotent: succeed if the identity does not have it.
  async revokeAccess(request: ServiceRevokeAccessRequest): Promise<ServiceRevokeAccessResponse> {
    const { credential, service, identity, role, permissions } = request;

    return {};
  },

  // Report the roles and permissions the identity holds on the service now, and whether a grant is
  // still pending.
  async getAccess(request: ServiceGetAccessRequest): Promise<ServiceGetAccessResponse> {
    const { credential, service, identity } = request;

    return { roles: [], permissions: [], pending: false };
  },
});

provider.serve();
